# Copia este archivo como ".env" y rellena lo que tengas.
# IMPORTANTE: el proyecto funciona SIN nada de esto (modo local).
# Cada clave que agregues activa una función extra.

PORT=3000

# --- Capa de lenguaje (IA) ---  Opcional.
# Groq: https://console.groq.com/keys   (capa gratuita)
# Si esta vacia, el chat usa el redactor local (plantillas) y sigue funcionando.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Cuentas + base de datos ---  Opcional.
# Supabase: https://supabase.com/dashboard  (Project Settings > API)
# Si estan vacias, la app funciona en "modo local" (datos en el navegador).
SUPABASE_URL=
SUPABASE_ANON_KEY=
